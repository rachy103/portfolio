    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_distal_tip.stl"/></geometry>
      <material name="fingertip_grey"/>
    </visual>
  </link>
  <link name="index_coupler_link">
