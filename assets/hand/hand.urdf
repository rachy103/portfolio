<?xml version="1.0"?>
<!-- Handling (SKKU) 16-DoF low-cost modular robot hand, LEFT hand. Web/visual model.
     Units: metres. Root: palm_link. +z = finger direction (up), -y = palm side
     (fingers flex toward -y), +x = little-finger side, thumb on the -x side.
     16 actuated joints (4 x abd/mcp/pip + thumb cmc/mcp/pip/dip); finger DIP and the
     3 mm coupler link are <mimic> joints of PIP (passive PIP-DIP four-bar).
     Generated from the Inventor assembly (left hand v2.iam) by build_web_hand.py.
     DIP mimic = linear fit of the four-bar; exact PIP->DIP table in hand_meta.json -->
<robot name="handling_hand_left">
  <material name="black_pla"><color rgba="0.160000 0.165000 0.175000 1.000000"/></material>
  <material name="fingertip_grey"><color rgba="0.780000 0.785000 0.770000 1.000000"/></material>
  <link name="palm_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/palm.stl"/></geometry>
      <material name="black_pla"/>
    </visual>
  </link>
  <link name="index_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_base.stl"/></geometry>
      <material name="black_pla"/>
    </visual>
  </link>
  <link name="index_abd_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_abd.stl"/></geometry>
      <material name="black_pla"/>
    </visual>
  </link>
  <link name="index_proximal_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="meshes/finger_proximal.stl"/></geometry>
      <material name="black_pla"/>
    </visual>
  </link>
  <link name="index_middle_link">
